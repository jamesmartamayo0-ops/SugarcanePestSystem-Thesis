SECRET_KEY=CHANGE_ME
SESSION_COOKIE_SECURE=false
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DB_HOST=localhost
DB_PORT=5434
DB_NAME=sugarcane_pest_db
DB_USER=sugarcane_app
DB_PASSWORD=CHANGE_ME

# Evidence storage: local (default) or blob (private Vercel Blob).
EVIDENCE_STORAGE=local

# Required only when EVIDENCE_STORAGE=blob. Leave blank locally.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Explicit opt-in for seeding a non-local database. Defaults to sugarcane_pest_test.
# DEMO_SEED_DATABASE=sugarcane_pest_test
# Required only if the seed must create the synthetic technician.
# DEMO_TECH_PASSWORD=

# Optional. Defaults to backend/instance/pest-evidence when unset.
# EVIDENCE_UPLOAD_DIR=C:\path\to\evidence
